{
  "name": "cabina",
  "version": "1.0.0",
  "private": true,
  "description": "Cabina · cockpit de sesión para futuros e inversiones. Una sola página, sin build.",
  "type": "module",
  "scripts": {
    "bundle": "node engine/quant/bundle.mjs",
    "check:bundle": "node engine/quant/bundle.mjs --check",
    "audit:security": "node test/seguridad.mjs",
    "test": "node test/correr.mjs",
    "serve": "python3 -m http.server 8000",
    "compuerta": "node test/compuerta.mjs",
    "ci:guardrails": "npm run check:bundle && npm run audit:security"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  },
  "engines": {
    "node": ">=20"
  }
}
